# resolve BACKEND_HOST at request time (via NGINX_LOCAL_RESOLVERS, sourced from
# /etc/resolv.conf by the base image entrypoint) instead of once at nginx startup,
# so the container doesn't refuse to start if the backend Service isn't up/resolvable yet
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # enable rewrite for react router
    location / {
        try_files $uri /index.html;
    }

    # backend is reached through the same origin, avoiding CORS and letting
    # BACKEND_HOST/BACKEND_PORT point at the k8s Service (or docker link) by name
    location /api/ {
        set $backend "http://${BACKEND_HOST}:${BACKEND_PORT}";
        # proxy_pass to a variable skips nginx's usual location-prefix
        # rewriting, so without this the full "/api/..." path would reach
        # the backend unstripped - its routes are registered without an
        # /api prefix (see /alive, /auth, /account, ...).
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
